{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-plugin-variantizer",
  "version": "0.1.0",
  "description": "OpenCode plugin that uses TypeSafe to select task-appropriate agents and reasoning variants.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "typesafe-ai",
    "ai-routing",
    "model-routing"
  ],
  "homepage": "https://github.com/Melivo/opencode-plugin-variantizer#readme",
  "bugs": {
    "url": "https://github.com/Melivo/opencode-plugin-variantizer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Melivo/opencode-plugin-variantizer.git"
  },
  "license": "MIT",
  "author": "Melivo",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "npm run test:contract && npm run test:unit && npm run test:integration && npm run test:evaluation && npm run test:docs && npm run test:privacy",
    "test:privacy": "bun test test/integration/privacy.test.ts",
    "test:contract": "node --test test/contract/contract-spike.test.mjs test/contract/model-routing-contract-spike.test.mjs test/contract/model-tui-contract-spike.test.mjs test/contract/agent-routing-contract-spike.test.mjs test/contract/agent-tui-contract-spike.test.mjs && bun test test/contract/production-hook-contract.test.ts",
    "test:integration": "bun test test/integration",
    "test:unit": "bun test test/unit",
    "test:evaluation": "bun test test/evaluation/evaluation.test.ts",
    "test:docs": "bun test test/evaluation/docs.test.ts",
    "typecheck": "tsc --noEmit",
    "ci": "npm run typecheck && npm test",
    "prepublishOnly": "npm run ci"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.31",
    "@typesafe-ai/sdk": "0.6.0",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "typescript": "5.9.2"
  }
}
