{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "luna",
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true }
  },
  "mcp": {
    "gortex": {
      "type": "local",
      "command": [
        "gortex",
        "mcp",
        "--tools",
        "compact"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics",
        "--isolated"
      ],
      "enabled": true
    }
  }
}
