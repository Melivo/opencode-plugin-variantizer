{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "./plugins/oma/oma.ts",
    [
      "./plugins/typesafe-variant-router/index.ts",
      {
        "fallbackVariant": "medium",
        "notify": "always"
      }
    ]
  ],
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics",
        "--isolated"
      ],
      "enabled": true
    },
    "gortex": {
      "type": "local",
      "command": [
        "gortex",
        "mcp",
        "--tools",
        "compact"
      ],
      "enabled": true
    }
  }
}
